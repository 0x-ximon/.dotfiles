[
	{
		"bindings": {
			"ctrl-f": "workspace::Open"
		}
	},

	{
		"context": "(Editor && edit_prediction)",
		"bindings": {
			"alt-l": null,
			"alt-j": null,
			"alt-k": null,
			"alt-tab": null,
			"tab": "editor::Tab",
			"shift-space": "editor::AcceptEditPrediction",
			"alt-space": "editor::AcceptNextWordEditPrediction"
		}
	},

	{
		"context": "Editor && vim_mode == normal",
		"bindings": {
			"?": "editor::Hover",
			"!": "editor::Hover",

			"U": "editor::Redo",
			"esc": "buffer_search::Dismiss",
			"alt-x": "command_palette::Toggle",

			"[ tab": "pane::ActivatePreviousItem",
			"] tab": "pane::ActivateNextItem",

			"alt-\\": "pane::SplitRight",
			"alt--": "pane::SplitDown",

			"H": "editor::MoveToBeginningOfLine",
			"L": "editor::MoveToEndOfLine",
			"J": "editor::MoveToEndOfParagraph",
			"K": "editor::MoveToStartOfParagraph",

			"alt-h": "workspace::ActivatePaneLeft",
			"alt-l": "workspace::ActivatePaneRight",
			"alt-j": "workspace::ActivatePaneDown",
			"alt-k": "workspace::ActivatePaneUp",

			"alt-up": "workspace::MovePaneUp",
			"alt-down": "workspace::MovePaneDown",
			"alt-left": "workspace::MovePaneLeft",
			"alt-right": "workspace::MovePaneRight",

			"space l a": "editor::ToggleCodeActions",
			"space l f": "editor::Format",
			"space l r": "editor::Rename",

			"space w": "workspace::Save",
			"space q": "pane::CloseActiveItem",
			"space t": "workspace::NewCenterTerminal",
			"space space": "file_finder::Toggle",

			"space /": "workspace::NewSearch",
			"space %": "git_panel::ToggleFocus",
			"space ~": "project_panel::ToggleFocus",

			"space (": "workspace::ToggleLeftDock",
			"space )": "workspace::ToggleRightDock",

			"gd": "editor::GoToDefinition",
			"ge": "editor::GoToDeclaration",
			"gr": "editor::FindAllReferences",
			"gi": "editor::GoToImplementation",
			"gt": "editor::GoToTypeDefinition"
		}
	}
]
